# Max upload size in MB
MAX_UPLOAD_MB=500
NEXT_PUBLIC_MAX_UPLOAD_MB=500

# Storage root (default: ./data) — shared volume in Docker at /data
DATA_DIR=./data

# App DB — SQLite (local) OR Postgres (Docker / multi-process)
# SQLITE_PATH=./data/app.sqlite
# DATABASE_URL=postgres://scorm:scorm@localhost:5432/scorm

# Redis / BullMQ (required for docker worker; optional locally — falls back to in-process)
# REDIS_URL=redis://127.0.0.1:6379
CONVERT_CONCURRENCY=2
TTS_CONCURRENCY=4
EXPORT_CONCURRENCY=1
CONVERT_QUEUE_MAX=50

# MinIO / S3 object storage (optional locally; enabled in docker-compose)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=scorm
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# Docker compose secrets
POSTGRES_USER=scorm
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=scorm
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password

# Retention (scripts/retention.ts)
EXPORT_RETENTION_DAYS=14
GUEST_PROJECT_RETENTION_DAYS=7

# Auth (required for production — change this secret)
AUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cookie Secure flag. On HTTP (no TLS yet) set false so guest/session cookies work.
# COOKIE_SECURE=false
# After HTTPS is live, set NEXT_PUBLIC_APP_URL=https://... (Secure cookies auto-enable)
# or COOKIE_SECURE=true

# Comma-separated admin emails (system admins for /admin)
# Example: ADMIN_EMAILS=admin@scormcreator.local,ops@company.com
# Default seeded admin: admin@scormcreator.local / Admin@123
ADMIN_EMAILS=admin@scormcreator.local

# Google OAuth (optional — enable “Tiếp tục với Google”)
# Create credentials at https://console.cloud.google.com/
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# EverAI Text-to-Speech (optional fallback; UI settings take priority)
# Get a key at https://everai.vn/api
EVERAI_API_KEY=
EVERAI_API_BASE=https://www.everai.vn/api/v1

# PayOS payment links + webhook (https://my.payos.vn)
# Có thể nhập từ Admin → Credit. Env dùng làm fallback nếu admin chưa lưu.
# Register webhook: {PAYOS_RETURN_BASE_URL}/api/payos/webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_BASE_URL=http://localhost:3000

# Slide image render (LibreOffice first on all OS; Windows can fall back to WPS/PowerPoint)
# Windows install usually exposes: C:\Program Files\LibreOffice\program\soffice.com
# Linux: sudo apt install libreoffice
# Optional if soffice is not auto-detected:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com
LIBREOFFICE_PATH=
