# Max upload size in MB
MAX_UPLOAD_MB=500
NEXT_PUBLIC_MAX_UPLOAD_MB=500

# Storage root (default: ./data)
DATA_DIR=./data
# App DB (users, plans, usage, TTS settings, jobs). Default: {DATA_DIR}/app.sqlite
# SQLITE_PATH=./data/app.sqlite

# Auth (required for production — change this secret)
AUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated admin emails (system admins for /admin)
# Example: ADMIN_EMAILS=admin@scormcreator.local,ops@company.com
# Default seeded admin: admin@scormcreator.local / Admin@123
ADMIN_EMAILS=admin@scormcreator.local

# Google OAuth (optional — enable “Tiếp tục với Google”)
# Create credentials at https://console.cloud.google.com/
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# EverAI Text-to-Speech (optional fallback; UI settings take priority)
# Get a key at https://everai.vn/api
EVERAI_API_KEY=
EVERAI_API_BASE=https://www.everai.vn/api/v1

# PayOS payment links + webhook (https://my.payos.vn)
# Có thể nhập từ Admin → Credit. Env dùng làm fallback nếu admin chưa lưu.
# Register webhook: {PAYOS_RETURN_BASE_URL}/api/payos/webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_BASE_URL=http://localhost:3000

# Slide image render (LibreOffice first on all OS; Windows can fall back to WPS/PowerPoint)
# Windows install usually exposes: C:\Program Files\LibreOffice\program\soffice.com
# Linux: sudo apt install libreoffice
# Optional if soffice is not auto-detected:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com
LIBREOFFICE_PATH=
