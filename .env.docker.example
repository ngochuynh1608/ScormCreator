# Copy to .env.docker and use with: npm run docker:up
# Local production-like stack (Compose) — same services as VPS.

MAX_UPLOAD_MB=500
NEXT_PUBLIC_MAX_UPLOAD_MB=500

CONVERT_CONCURRENCY=2
TTS_CONCURRENCY=4
EXPORT_CONCURRENCY=1
CONVERT_QUEUE_MAX=50

POSTGRES_USER=scorm
POSTGRES_PASSWORD=scorm-local-dev
POSTGRES_DB=scorm
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=scorm

AUTH_SECRET=local-docker-dev-secret-change-me
# Local compose maps Caddy 8080/8443; site block uses localhost
NEXT_PUBLIC_APP_URL=http://localhost:8080
COOKIE_SECURE=false
CADDY_SITE=localhost
CADDY_EMAIL=

ADMIN_EMAILS=admin@scormcreator.local

EVERAI_API_KEY=
EVERAI_API_BASE=https://www.everai.vn/api/v1

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_BASE_URL=http://localhost:8080

# Email OTP (Resend) — optional env fallback. Prefer Admin → Email OTP.
RESEND_API_KEY=
EMAIL_FROM=ScormCreator <noreply@example.com>

LIBREOFFICE_PATH=
